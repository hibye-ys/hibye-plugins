# Hono + Cloudflare Workers preset — scripts/audit-all.sh 의 framework-specific 패턴 정의
#
# 사용:
#   source scripts/presets/hono-workers.env
#   bash scripts/audit-all.sh apps/api
#
# 또는 CI env block 에 명시:
#   env:
#     REQUEST_BODY_PATTERN: 'c\.req\.(json|valid|parseBody)'
#     ...
#
# 본 plugin (stack-backend-ts) 의 audit-all.sh 는 framework-neutral 이며,
# 본 preset 은 가장 흔한 instance (Hono + Cloudflare Workers) 의 기본 패턴이다.
# 다른 framework / runtime (Express + Redis, Fastify + Postgres 등) 은 별도 preset 파일을
# 추가하거나 env block 에 직접 명시.

# api-audit / input-safety-audit: request body accessor
export REQUEST_BODY_PATTERN='c\.req\.(json|valid|parseBody)'

# session-audit: framework env 의 KV binding 직접 접근 패턴 (storage adapter 우회 검출)
export KV_BINDING_PATTERN='c\.env\.[A-Z_]+'

# api-audit: route handler 정의 패턴 (mutation only — POST/PUT/PATCH)
export ROUTE_MUTATION_PATTERN='app\.(post|put|patch)'

# api-audit: schema validator 미들웨어 (Hono = @hono/zod-validator)
export ZOD_VALIDATOR_PATTERN='zValidator'

# session-audit: KV store 어휘 (Cloudflare Workers KV)
export KV_STORE_PATTERN='(KV|kv)'

# session-audit: TTL 필드 (Workers KV = expirationTtl)
export TTL_FIELD_PATTERN='expirationTtl'

# api-audit: protected route auth middleware 함수 이름
export AUTH_MIDDLEWARE_NAME='authMiddleware'
