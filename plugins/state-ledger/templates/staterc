# state-ledger 설정 — 프로젝트 루트에 `.staterc` 로 복사 (없으면 기본값).
# 형식 고정: KEY="value" 한 줄씩. 스크립트는 source 하지 않고 sed 로 파싱한다
# — 다른 문법·명령 치환은 무시되며, 경로 목록은 공백 구분(공백 포함 경로 미지원).

STATE_INDEXES="STATE.md"
STATE_DEFAULT_BRANCH="main"

# 턴 작업으로 취급할 경로. 둘 다 JavaScript RegExp 문자열이며 include 후 exclude 한다.
# 기본값은 .staterc 자체, 일반 소스·설정·에셋과 prompt/agent/skill/command Markdown을 포함한다.
STATE_WORK_INCLUDE_RE="(^|/)\.staterc$|(^|/)Dockerfile$|\.(ts|tsx|js|jsx|mjs|cjs|sh|py|css|html|svg|ya?ml|json|sql|toml|go|rs|java|kt|swift|c|cc|cpp|h|hpp|png|jpe?g|webp|gif|avif|woff2?|ttf|otf)$|(^|/)(prompts?|agents?|skills?|commands?)/.*\.md$"
STATE_WORK_EXCLUDE_RE="(^|/)(node_modules|dist|build|coverage|vendor)/"

# branch-sync 유령 검사에서 제외할 브랜치 glob 목록 (공백 구분).
STATE_BRANCH_EXCLUDE="task-loop/*"
