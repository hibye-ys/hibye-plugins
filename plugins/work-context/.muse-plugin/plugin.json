{
  "schemaVersion": 1,
  "name": "work-context",
  "version": "0.1.4",
  "displayName": "Work Context",
  "description": "계획 폴더의 목표·지시·진행을 세션 시작과 매 턴, 계획 파일 편집 뒤에 주입한다.",
  "compat": {
    "manifestDir": ".muse-plugin",
    "source": "native"
  },
  "capabilities": {
    "commands": [],
    "hooks": [
      {
        "command": [
          "node",
          "hooks/muse-session-start.cjs"
        ],
        "event": "SessionStart",
        "id": "session-start",
        "statusMessage": "작업 맥락 주입",
        "timeoutMs": 30000
      },
      {
        "command": [
          "node",
          "hooks/muse-turn.cjs"
        ],
        "event": "UserPromptSubmit",
        "id": "turn",
        "statusMessage": "작업 맥락 확인",
        "timeoutMs": 15000
      },
      {
        "command": [
          "node",
          "hooks/muse-post-edit.cjs"
        ],
        "event": "PostToolUse",
        "id": "post-edit",
        "statusMessage": "계획 파일 변경 반영",
        "timeoutMs": 15000
      }
    ],
    "mcpServers": [],
    "reminders": [],
    "skills": [
      {
        "id": "work-context",
        "path": "skills/work-context/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "memory-upkeep",
        "path": "skills/memory-upkeep/SKILL.md",
        "enabledDefault": true
      }
    ]
  }
}
