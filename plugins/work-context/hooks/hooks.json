{
  "description": "작업 맥락 주입: 세션 시작·매 턴·계획 파일 편집 뒤 계획 폴더·운영 결정·메모리 인덱스를 주입한다.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/work-context.cjs\" session-start",
            "statusMessage": "작업 맥락 주입",
            "timeout": 30,
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/work-context.cjs\" turn",
            "statusMessage": "작업 맥락 확인",
            "timeout": 15,
            "additionalContextLimit": 10000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/work-context.cjs\" post-edit",
            "statusMessage": "계획 파일 변경 반영",
            "timeout": 15,
            "additionalContextLimit": 10000
          }
        ]
      }
    ]
  }
}
