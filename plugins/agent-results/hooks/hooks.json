{
  "description": "Opt-in local result collection. No model calls, automatic edits, blocking or continuation.",
  "hooks": {
    "SessionStart": [{ "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\"", "timeout": 15, "additionalContextLimit": 600 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\"", "timeout": 15 }] }],
    "PostToolUse": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\"", "timeout": 15 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\" claude", "timeout": 15 }] }],
    "PostToolUseFailure": [{ "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\" claude", "timeout": 15 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PLUGIN_ROOT/scripts/hook.cjs\" claude", "timeout": 15 }] }]
  }
}
