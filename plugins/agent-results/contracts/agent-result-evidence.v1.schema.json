{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-result-evidence.v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string",
          "const": "api"
        },
        "project_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "session_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "run_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "service",
        "project_id",
        "session_id",
        "run_id"
      ],
      "additionalProperties": false
    },
    "exported_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "collection_status": {
      "type": "string",
      "const": "partial"
    },
    "replay_ready": {
      "type": "boolean",
      "const": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "string",
          "const": "selected_run_only"
        },
        "followup_feedback": {
          "type": "string",
          "const": "not_collected"
        },
        "provider_calls": {
          "type": "string",
          "const": "separate_export"
        },
        "effect_records": {
          "type": "string",
          "const": "dispatch_receipts_only"
        }
      },
      "required": [
        "messages",
        "followup_feedback",
        "provider_calls",
        "effect_records"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_messages": {
          "type": "number",
          "const": 20
        },
        "max_field_bytes": {
          "type": "number",
          "const": 65536
        }
      },
      "required": [
        "max_messages",
        "max_field_bytes"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "owner_user_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "run_status": {
          "type": "string",
          "enum": [
            "in_progress",
            "awaiting_input",
            "completed",
            "failed",
            "expired",
            "cancelled",
            "handed_off"
          ]
        },
        "can_cancel_run": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "awaiting_input",
            "completed",
            "failed",
            "expired",
            "cancelled",
            "handed_off",
            "queued",
            "outcome_unknown"
          ]
        },
        "unsettled_operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "finality": {
          "type": "string",
          "enum": [
            "active",
            "settled",
            "unsettled",
            "outcome_unknown",
            "unknown"
          ]
        },
        "delegated_task": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "running",
                    "awaiting_input",
                    "succeeded",
                    "failed",
                    "cancelled",
                    "outcome_unknown"
                  ]
                },
                "step": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "version": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "status",
                "step",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "main_reply": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "result_sequence": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "attempted",
                    "output",
                    "delivered",
                    "outcome_unknown",
                    "access_revoked"
                  ]
                },
                "delivered_run_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "result_sequence",
                "state",
                "delivered_run_id"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "type": "object",
          "properties": {
            "delivery_kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "delegated_task_turn",
                    "delegated_main_reply"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "lease": {
              "type": "string",
              "enum": [
                "active",
                "expired",
                "not_required",
                "unknown"
              ]
            },
            "delivery_status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pending",
                    "in_progress",
                    "completed",
                    "failed",
                    "dead_letter"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "checkpoint_available": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "delivery_kind",
            "lease",
            "delivery_status",
            "checkpoint_available"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "owner_user_id",
        "run_status",
        "can_cancel_run",
        "status",
        "unsettled_operation_ids",
        "finality",
        "delegated_task",
        "main_reply",
        "recovery"
      ],
      "additionalProperties": false
    },
    "messages": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "parent_message_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sequence": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,18})$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,18})$"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool",
              "system"
            ]
          },
          "content_kind": {
            "type": "string",
            "enum": [
              "text",
              "tool_call",
              "tool_result",
              "action",
              "notification"
            ]
          },
          "content": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema0"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_status": {
            "type": "string",
            "enum": [
              "stored",
              "oversized"
            ]
          },
          "tool_result": {
            "anyOf": [
              {
                "$ref": "#/$defs/__schema1"
              },
              {
                "type": "null"
              }
            ]
          },
          "tool_result_status": {
            "type": "string",
            "enum": [
              "full",
              "preview",
              "oversized",
              "missing",
              "not_applicable"
            ]
          },
          "dispatch_receipt": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "dispatch_key": {
                    "type": "string",
                    "pattern": "^tdk_v2_[a-f0-9]{64}$"
                  },
                  "attempt_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "input_fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "result_ok": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "dispatch_key",
                  "attempt_id",
                  "input_fingerprint",
                  "result_ok"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "parent_message_id",
          "sequence",
          "version",
          "role",
          "content_kind",
          "content",
          "content_status",
          "tool_result",
          "tool_result_status",
          "dispatch_receipt",
          "created_at",
          "updated_at"
        ],
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,18})$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "source",
    "exported_at",
    "collection_status",
    "replay_ready",
    "coverage",
    "limits",
    "execution",
    "messages",
    "next_cursor"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    }
  }
}
